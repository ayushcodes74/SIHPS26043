# ==============================================================================
# CIVICSYNC ENVIRONMENT CONFIGURATION & API KEYS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI PROVIDER API KEYS (Paste your API keys below)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Recommended for fast & accurate multimodal reasoning)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# xAI Grok API Key
# Get key from: https://console.x.ai/
XAI_API_KEY=

# OpenRouter API Key (Access to OpenAI, Claude, Llama, Mistral models)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Provider Execution Hierarchy (Comma-separated: gemini, grok, openrouter, nlp)
# The system tries providers in this order, with 'nlp' as the guaranteed local fallback.
AI_PROVIDER_ORDER=gemini,grok,openrouter,nlp

# AI Request Timeouts (milliseconds)
AI_TIMEOUT_MS=10000
AI_EXPLANATION_TIMEOUT_MS=2500

# ------------------------------------------------------------------------------
# 2. SERVER & SECURITY
# ------------------------------------------------------------------------------
PORT=5000
JWT_SECRET=civicsync_secure_jwt_secret_key_2026
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL / In-Memory Fallback)
# ------------------------------------------------------------------------------
# Note: If PostgreSQL is not running on port 5432, CivicSync automatically 
# activates its resilient in-memory database store so the app works with zero setup.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=civicsync
DB_USER=postgres
DB_PASSWORD=postgres
